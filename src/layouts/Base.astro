---
import AuthGate from '../components/AuthGate.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Knowledge', description = 'Personal knowledge base' } = Astro.props;
const useAuth = !!import.meta.env.PUBLIC_COGNITO_USER_POOL_ID;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title === 'Knowledge' ? title : `${title} — Knowledge`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-title"><span>~/</span>knowledge</a>
      <nav class="site-nav">
        <a href="/">all</a>
        <a href="/categories">categories</a>
      </nav>
    </div>
  </header>
  <main>
    <div class="container">
      {useAuth ? (
        <AuthGate>
          <slot />
        </AuthGate>
      ) : (
        <slot />
      )}
    </div>
  </main>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

# Amplify Auth Environment Variables
# Fill these in after setting up your Cognito User Pool

PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
PUBLIC_COGNITO_CLIENT_ID=your-client-id
PUBLIC_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
PUBLIC_REDIRECT_SIGN_IN=https://your-amplify-domain.amplifyapp.com/
PUBLIC_REDIRECT_SIGN_OUT=https://your-amplify-domain.amplifyapp.com/
